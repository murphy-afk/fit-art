---
import { SITE } from '../data/site';

/**
 * Social icons - Session 7 follow-up (client request: "icon logos for the
 * social media pages"). Lucide does not ship brand icons, so the three marks
 * are hand-drawn inline SVGs in Lucide's stroke style (24x24 viewBox,
 * currentColor, stroke-width 2) - decision logged in docs/DECISIONS.md.
 * Keyed by the social labels in src/data/site.ts (single source of truth).
 */
const socialIcons: Record<string, string> = {
  Instagram:
    '<rect width="20" height="20" x="2" y="2" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/>',
  Facebook:
    '<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/>',
  TikTok:
    '<path d="M14 3v11a4 4 0 1 1-4-4"/><path d="M14 3c.6 2.8 2.6 4.8 5.5 5"/>',
};
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <h2>{SITE.brand}</h2>
      <p>
        {SITE.tagline}: l'unica palestra in Italia che è anche galleria d'arte.
        Allenamenti personalizzati, preparazione atletica, posturologia,
        chinesiologia e massoterapia a {SITE.city}.
      </p>
    </div>

    <div>
      <h2>Contatti</h2>
      <ul>
        {SITE.phones.map((phone) => (
          <li><a href={phone.href}>{phone.label}</a></li>
        ))}
        <!-- PLACEHOLDER EMAIL (docs/DECISIONS.md §1): swap in the official email -->
        <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
        <li>{SITE.hours.weekday}</li>
        <li>{SITE.hours.weekend}</li>
      </ul>
    </div>

    <div>
      <h2>Social</h2>
      <ul class="social-list">
        {
          SITE.socials.map((social) => (
            <li>
              <a href={social.href} rel="me noopener" target="_blank">
                <svg
                  class="social-icon"
                  viewBox="0 0 24 24"
                  width="18"
                  height="18"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                  focusable="false"
                  set:html={socialIcons[social.label]} />
                {social.label}<span class="visually-hidden"> (si apre in una nuova finestra)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <div class="container footer-bottom">
    <span>© 2026 {SITE.name} · {SITE.address}</span>
    <span>Prototipo in costruzione</span>
  </div>
</footer>
