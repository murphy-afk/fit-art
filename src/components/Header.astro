---
import { NAV, SITE } from '../data/site';
import type { NavSlug } from '../data/site';

interface Props {
  current?: NavSlug;
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="Fit'Art — Home">
      <!-- Logo candidato: foto profilo Instagram (docs/DECISIONS.md) — sostituire con il logo ufficiale quando disponibile -->
      <img src="/images/logo-s150x150.jpg" alt="" width="40" height="40" />
      <span class="brand-name">
        {SITE.brand}
        <small>{SITE.tagline} · {SITE.city}</small>
      </span>
    </a>

    <nav aria-label="Navigazione principale">
      <button
        id="nav-toggle"
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Apri menu">☰</button
      >
      <ul id="nav-menu" class="nav-menu">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={current === item.slug ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header-cta" href={SITE.phones[0].href}>
      Chiama: {SITE.phones[0].label}
    </a>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');
  btn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open');
    btn?.setAttribute('aria-expanded', String(open));
  });
</script>
