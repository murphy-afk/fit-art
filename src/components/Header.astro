---
import { Menu, Phone } from '@lucide/astro';
import { NAV, SITE, path } from '../data/site';
import type { NavSlug } from '../data/site';

interface Props {
  current?: NavSlug;
}

const { current } = Astro.props;
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={path('/')} aria-label="Fit'Art: Home">
      <!-- Logo candidate: Instagram profile picture (docs/DECISIONS.md) - replace with the official logo when available -->
      <img src={path('/images/logo-s150x150.jpg')} alt="" width="40" height="40" />
      <span class="brand-name">
        {SITE.brand}
        <small>{SITE.tagline} · {SITE.city}</small>
      </span>
    </a>

    <nav aria-label="Navigazione principale">
      <button
        id="nav-toggle"
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label="Apri menu"><Menu size={18} aria-hidden="true" /></button>
      <ul id="nav-menu" class="nav-menu">
        {
          NAV.map((item) => (
            <li>
              <a
                href={path(item.href)}
                aria-current={current === item.slug ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <a class="header-cta" href={SITE.phones[0].href}>
      <Phone size={16} aria-hidden="true" />
      Chiama {SITE.phones[0].label}
    </a>
  </div>
</header>

<script is:inline>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('nav-menu');

  const setOpen = (open) => {
    if (!btn || !menu) return;
    menu.classList.toggle('open', open);
    btn.setAttribute('aria-expanded', String(open));
    btn.setAttribute('aria-label', open ? 'Chiudi menu' : 'Apri menu');
  };

  btn?.addEventListener('click', () => {
    setOpen(!menu?.classList.contains('open'));
  });

  // Close the menu on Esc (keyboard)
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menu?.classList.contains('open')) {
      setOpen(false);
      btn?.focus();
    }
  });

  // Close the menu when clicking outside
  document.addEventListener('click', (event) => {
    if (!menu?.classList.contains('open')) return;
    const target = event.target;
    if (!(target instanceof Node)) return;
    if (!menu.contains(target) && !btn?.contains(target)) setOpen(false);
  });

  // Clicking a link closes the menu before navigating
  menu?.addEventListener('click', (event) => {
    const target = event.target;
    if (target instanceof Element && target.closest('a')) setOpen(false);
  });
</script>
