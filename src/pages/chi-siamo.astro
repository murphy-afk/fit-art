---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, path } from '../data/site';
import { IMG } from '../data/images';

/**
 * Areas of the gym - SAMPLE content for the template: replace with the
 * client's real spaces (docs/SETUP.md).
 */
const areas = [
  {
    name: 'Area cardio-tonica',
    desc: "L'area di allenamento cardiotonico, per il lavoro aerobico e il rafforzamento generale del corpo.",
  },
  {
    name: 'Sala corsi fitness e pilates',
    desc: 'La sala dedicata ai corsi di fitness e Pilates, con spazio curato per il lavoro in gruppo.',
  },
  {
    name: 'Attrezzature per l\'allenamento muscolare',
    desc: "Un grande spazio con le attrezzature per l'allenamento muscolare.",
  },
  {
    name: 'Zona functional',
    desc: 'La zona dedicata agli allenamenti a corpo libero e al functional training.',
  },
];
---

<BaseLayout
  title="Chi siamo"
  current="chi-siamo"
  description="Chi è [Nome Palestra] a [Città (PRO)]: gli spazi per il cardio, i corsi fitness e pilates, l'allenamento muscolare e il functional training.">
  <section class="container hero">
    <p class="eyebrow">La palestra</p>
    <h1>Chi siamo</h1>
    <p class="lede">
      Offriamo un completo spazio per lo sviluppo e l'allenamento fisico.
    </p>
  </section>

  <!-- Gli spazi - sample areas (docs/SETUP.md) -->
  <section class="section" aria-labelledby="spazi-title">
    <div class="container">
      <h2 id="spazi-title">Gli spazi</h2>
      <p class="lede">
        Abbiamo l'area di allenamento cardiotonico, la sala corsi fitness e
        pilates, un grande spazio per le attrezzature per l'allenamento
        muscolare e la TRAINING ZONE.
      </p>
      <div class="feature-grid">
        {
          areas.map((area) => (
            <article class="feature-card">
              <h3>{area.name}</h3>
              <p>{area.desc}</p>
            </article>
          ))
        }
      </div>
      <Image
        class="page-media"
        src={IMG.gallery1}
        alt="La sala corsi della palestra"
        width={534}
        sizes="(min-width: 72rem) 72rem, 100vw" />
    </div>
  </section>

  <!-- Unique selling point - PLACEHOLDER (docs/SETUP.md): replace with the client's real strength -->
  <section class="section section-alt" aria-labelledby="vantaggio-title">
    <div class="container">
      <p class="eyebrow">[Il tuo vantaggio unico]</p>
      <h2 id="vantaggio-title">[Perché scegliere questa palestra]</h2>
      <div class="prose">
        <!-- Sample copy - replace with the client's own words -->
        <p>
          [Due righe su cosa rende speciale la palestra: es. <strong>spazi ampi,
          attrezzature aggiornate e corsi in piccoli gruppi</strong>, così da
          seguirti passo passo verso i tuoi obiettivi.]
        </p>
      </div>
      <Image
        class="page-media"
        src={IMG.gallery2}
        alt="[Descrizione della foto]"
        width={534}
        sizes="(min-width: 72rem) 72rem, 100vw" />
    </div>
  </section>

  <!-- Team - sample copy (docs/SETUP.md) -->
  <section class="section" aria-labelledby="team-title">
    <div class="container">
      <h2 id="team-title">Una squadra di professionisti</h2>
      <div class="prose">
        <p>
          Contiamo su una squadra di professionisti pronta a sviluppare un
          programma che si adatti alle tue richieste e ti aiuti a raggiungere 
          <strong> ogni tuo obiettivo</strong>.
        </p>
        <p>
          Ti invitiamo a scoprire di più sui nostri servizi. Non esitare a
          contattarci per richiedere un'attenzione personalizzata.
        </p>
      </div>
      <p class="section-action">
        <a class="btn btn-primary" href={SITE.phones[0].href}>Chiamaci: {SITE.phones[0].label}</a>
        <a class="btn btn-ghost" href={path('/contatti')}>Contatti</a>
      </p>
    </div>
  </section>
</BaseLayout>
