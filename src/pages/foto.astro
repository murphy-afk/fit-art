---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, path } from '../data/site';
import { IMG } from '../data/images';

/**
 * Gallery photos - PLACEHOLDER stock images: replace with the client's own
 * photos in src/assets/images/ (same file names, see docs/SETUP.md).
 */
const photos = [
  { src: IMG.fotoPalestra, alt: 'Gli spazi della palestra' },
  { src: IMG.gallery1, alt: 'Sala corsi della palestra' },
  { src: IMG.gallery2, alt: 'Attrezzature per il fitness' },
  { src: IMG.gallery3, alt: 'Zona di allenamento' },
  { src: IMG.gallery4, alt: 'Dettaglio degli spazi della palestra' },
  { src: IMG.ginnasticaPosturale, alt: 'Ginnastica posturale in palestra' },
  { src: IMG.preparazioneAtletica, alt: 'Preparazione atletica in palestra' },
];
---

<BaseLayout
  title="Foto"
  current="foto"
  description="Foto di [Nome Palestra] a [Città (PRO)]: spazi, attrezzature e corsi.">
  <section class="container hero">
    <p class="eyebrow">Galleria</p>
    <h1>Foto</h1>
    <p class="lede">
      Guarda la palestra da vicino: spazi, attrezzature e corsi.
    </p>
  </section>

  <section class="section" aria-label="Galleria fotografica">
    <div class="container">
      <!-- Optional: add a <video> element here for a tour video (drop the MP4 in public/videos/) -->
      <div class="gallery-grid">
        {
          photos.map((photo) => (
            <Image
              class="gallery-item"
              src={photo.src}
              alt={photo.alt}
              width={534}
              sizes="(min-width: 48rem) 25vw, 50vw" />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="visita-title">
    <div class="container">
      <p class="eyebrow">{SITE.tagline}</p>
      <h2 id="visita-title">Vieni a trovarci</h2>
      <!-- Sample copy - replace with the client's own words (docs/SETUP.md) -->
      <p class="lede">
        Hai domande? Chiamaci per visitare la palestra e scoprire i corsi più
        adatti a te: valuteremo insieme le tue esigenze.
      </p>
      <p class="section-action">
        <a class="btn btn-primary" href={SITE.phones[0].href}>Chiamaci: {SITE.phones[0].label}</a>
        <a class="btn btn-ghost" href={path('/contatti')}>Contatti e come arrivare</a>
      </p>
    </div>
  </section>
</BaseLayout>
