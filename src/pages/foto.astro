---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, path } from '../data/site';
import { IMG } from '../data/images';

/**
 * The 7 gallery photos of the old site's Foto page
 * (docs/CONTENT-INVENTORY.md §Foto, docs/DECISIONS.md §3).
 * 4 were already downloaded as gallery-*.jpg for the homepage teaser and 2 as
 * service photos; foto-palestra.jpg is the remaining one (downloaded in Session 5).
 */
const photos = [
  { src: IMG.fotoPalestra, alt: 'Gli spazi della palestra Fit\u2019Art' },
  { src: IMG.gallery1, alt: 'Sala corsi della palestra Fit\u2019Art' },
  { src: IMG.gallery2, alt: 'Attrezzature per il fitness' },
  { src: IMG.gallery3, alt: 'Zona di allenamento Fit\u2019Art' },
  { src: IMG.gallery4, alt: 'Dettaglio degli spazi della palestra' },
  { src: IMG.ginnasticaPosturale, alt: 'Ginnastica posturale alla palestra Fit\u2019Art' },
  { src: IMG.preparazioneAtletica, alt: 'Preparazione atletica alla palestra Fit\u2019Art' },
];
---

<BaseLayout
  title="Foto"
  current="foto"
  description="Foto e video della palestra Fit'Art a Rosate (MI): spazi, attrezzature, corsi e galleria d'arte.">
  <section class="container hero">
    <p class="eyebrow">Galleria</p>
    <h1>Foto</h1>
    <p class="lede">
      Guarda la palestra da vicino: spazi, attrezzature, corsi e il video tour.
    </p>
  </section>

  <section class="section" aria-label="Galleria fotografica">
    <div class="container">
      <div class="gallery-grid">
        <video
          class="gallery-item gallery-video"
          src={path('/videos/palestra-tour.mp4')}
          controls
          preload="metadata"
          playsinline
          aria-label="Video tour della palestra">
          Il tuo browser non supporta la riproduzione video.
        </video>
        {
          photos.map((photo) => (
            <Image
              class="gallery-item"
              src={photo.src}
              alt={photo.alt}
              width={534}
              sizes="(min-width: 48rem) 25vw, 50vw" />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt" aria-labelledby="visita-title">
    <div class="container">
      <p class="eyebrow">Palestra &amp; galleria d'arte</p>
      <h2 id="visita-title">Vieni a trovarci</h2>
      <p class="lede">
        L'unica palestra in Italia che è anche una galleria d'arte. Chiama per
        visitare la palestra: valuteremo insieme le tue esigenze.
      </p>
      <p class="section-action">
        <a class="btn btn-primary" href={SITE.phones[0].href}>Chiamaci: {SITE.phones[0].label}</a>
        <a class="btn btn-ghost" href={path('/contatti')}>Contatti e come arrivare</a>
      </p>
    </div>
  </section>
</BaseLayout>
