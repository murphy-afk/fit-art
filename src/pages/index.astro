---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, path, addressLine, cityLine } from '../data/site';
import { IMG } from '../data/images';

/**
 * Homepage services - SAMPLE content for the template: replace names and
 * descriptions with the client's real offer (docs/SETUP.md).
 * Every card shows a photo; all images come from src/data/images.ts.
 */
const services = [
  {
    name: 'Functional Training',
    desc: "I nostri programmi personalizzati e la nostra esperienza ti permetteranno di curare il tuo corpo con le metodiche più avanzate scientificamente e più adeguate alle tue esigenze.",
    image: IMG.fotoPalestra,
  },
  {
    name: 'Pilates',
    desc: "Che cos'è il Pilates: un metodo di allenamento che insegna a prendere coscienza del proprio corpo, per rafforzarlo, correggere la postura e migliorare la fluidità e la precisione dei movimenti. Nel Pilates il corpo si muove come un sistema integrato e gran parte del lavoro è concentrato sui muscoli che favoriscono il controllo della postura.",
    benefits: [
      'Rinforza e tonifica i muscoli, ma non aumenta la massa muscolare',
      "Favorisce l'assunzione di posture corrette, proteggendo dal mal di schiena",
      'Fa acquisire una maggiore consapevolezza della dinamica del proprio corpo, migliorando il rapporto mente-corpo',
      'Contribuisce a dare maggiore sicurezza a livello fisico e psicologico, con un effetto anti-stress',
      'Aiuta a respirare meglio, con benefici su tutto il sistema cardiorespiratorio',
      'Nel bambino aiuta a correggere atteggiamenti posturali scorretti (cifosi, lordosi, ecc.)',
      'Rafforzando gli addominali, aiuta ad avere un ventre più piatto',
      "Migliora l'equilibrio e la coordinazione",
    ],
    image: IMG.pilates,
  },
  {
    name: 'Indoor Cycling',
    desc: 'La pedalata indoor a ritmo di musica: ti farà vivere il ciclismo come mai lo avevi provato.',
    image: IMG.indoorCycling,
  },
  {
    name: 'Dimagrire Veramente',
    desc: 'Modella il tuo corpo e perdi i centimetri che vuoi con i nostri programmi di allenamento personalizzati.',
    image: IMG.dimagrire,
  },
  {
    name: 'Ginnastica Posturale',
    desc: 'Esercizi mirati per correggere la postura e prevenire dolori e compensi.',
    image: IMG.ginnasticaPosturale,
  },
  {
    name: 'Ginnastica contro il mal di schiena',
    desc: 'Lavoro specifico per alleviare e prevenire il mal di schiena.',
    image: IMG.malDiSchiena,
  },
  {
    name: 'Preparazione Atletica',
    desc: 'Programmi di preparazione per migliorare la prestazione e la condizione atletica.',
    image: IMG.preparazioneAtletica,
  },
  {
    name: 'Rieducazione funzionale dopo infortuni e operazioni',
    desc: 'Recupero del movimento dopo infortuni e operazioni, con un percorso personalizzato.',
    image: IMG.rieducazioneFunzionale,
  },
];

const galleryPhotos = [
  { src: IMG.gallery1, alt: 'Sala corsi della palestra' },
  { src: IMG.gallery2, alt: 'Attrezzature per il fitness' },
  { src: IMG.gallery3, alt: 'Zona di allenamento' },
  { src: IMG.gallery4, alt: 'Dettaglio degli spazi della palestra' },
];
---

<BaseLayout
  title="Palestra e centro fitness a [Città (PRO)]"
  current="home"
  description="[Nome Palestra] a [Città (PRO)]: functional training, pilates, indoor cycling, preparazione atletica, ginnastica posturale e allenamenti personalizzati. Aperti tutti i giorni.">
  <!-- Hero full-bleed -->
  <section class="home-hero">
    <div class="home-hero-media" aria-hidden="true">
      <Image
        src={IMG.heroFunctional}
        alt=""
        width={1108}
        sizes="100vw"
        loading="eager"
        fetchpriority="high" />
    </div>
    <div class="container home-hero-inner">
      <p class="eyebrow">{SITE.tagline} · {cityLine}</p>
      <!-- PLACEHOLDER (docs/SETUP.md): brand + slogan -->
      <h1>{SITE.brand}: [slogan]</h1>
      <!-- Sample hero copy - replace with the client's own words (docs/SETUP.md) -->
      <p class="lede home-hero-lede">
        La nostra esperienza è a disposizione per il tuo benessere: corsi,
        allenamenti personalizzati e attrezzature moderne, a portata di mano in
        qualsiasi momento della giornata.
      </p>
      <div class="home-hero-actions">
        <a class="btn btn-primary" href={SITE.phones[0].href}>Chiama il {SITE.phones[0].label}</a>
        <a class="btn btn-ghost" href="#servizi">Scopri i corsi</a>
      </div>
    </div>
  </section>

  <!-- Hours -->
  <section class="section home-hours" aria-labelledby="orari-title">
    <div class="container">
      <p class="eyebrow">I nostri orari</p>
      <h2 id="orari-title">Aperti tutti i giorni</h2>
      <div class="hours-grid">
        <div class="hours-card">
          <h3>{SITE.hours.weekday.label}</h3>
          <p class="hours-time">{SITE.hours.weekday.opens}-{SITE.hours.weekday.closes}</p>
        </div>
        <div class="hours-card">
          <h3>{SITE.hours.weekend.label}</h3>
          <p class="hours-time">{SITE.hours.weekend.opens}-{SITE.hours.weekend.closes}</p>
        </div>
        <div class="hours-card">
          <h3>Dove siamo</h3>
          <p class="hours-time hours-address">{addressLine}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section section-alt" id="servizi" aria-labelledby="servizi-title">
    <div class="container">
      <p class="eyebrow">I servizi</p>
      <h2 id="servizi-title">Le migliori attrezzature, un ambiente curato</h2>
      <p class="lede">
        Dove il benessere è il protagonista: scegli il corso più adatto a te.
      </p>

      <div class="services-grid">
        {
          services.map((service) => (
            <article class="service-card">
              <Image
                class="service-media"
                src={service.image}
                alt=""
                width={640}
                sizes="(min-width: 64rem) 25vw, (min-width: 48rem) 50vw, 100vw" />
              <div class="service-body">
                <h3>{service.name}</h3>
                <p>{service.desc}</p>
                {service.benefits && (
                  <details class="service-details">
                    <summary>Gli 8 vantaggi del Pilates</summary>
                    <ul>
                      {service.benefits.map((item) => (
                        <li>{item}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Success story - PLACEHOLDER: replace with a real client story (docs/SETUP.md) -->
  <section class="section" aria-labelledby="storia-title">
    <div class="container story-grid">
      <div class="story-text">
        <p class="eyebrow">Storia di successo</p>
        <h2 id="storia-title">[Nome del cliente]: [il risultato raggiunto]</h2>
        <p class="lede">
          [Due righe sul percorso: es. "Otto mesi di allenamento personalizzato
          e un piano alimentare su misura per raggiungere il suo obiettivo."]
        </p>
        <a class="btn btn-primary" href={SITE.phones[1].href}>Parliamone: {SITE.phones[1].label}</a>
      </div>
      <div class="story-media">
        <Image
          src={IMG.storia1}
          alt="[Descrizione della foto]"
          width={534}
          sizes="(min-width: 48rem) 50vw, 100vw" />
        <Image
          src={IMG.storia2}
          alt="[Descrizione della foto]"
          width={534}
          sizes="(min-width: 48rem) 50vw, 100vw" />
      </div>
    </div>
  </section>

  <!-- Gallery teaser -->
  <section class="section section-alt" aria-labelledby="galleria-title">
    <div class="container">
      <p class="eyebrow">{SITE.tagline}</p>
      <h2 id="galleria-title">Guarda la palestra da vicino</h2>
      <p class="lede">
        Le foto degli spazi, delle attrezzature e dei corsi: scopri dove
        allenerai.
      </p>
      <!-- Optional: add a <video> element here for a tour video (drop the MP4 in public/videos/) -->
      <div class="gallery-grid">
        {
          galleryPhotos.map((photo) => (
            <Image
              class="gallery-item"
              src={photo.src}
              alt={photo.alt}
              width={534}
              sizes="(min-width: 48rem) 25vw, 50vw" />
          ))
        }
      </div>
      <p class="section-action">
        <a class="btn btn-ghost" href={path('/foto')}>Vedi tutte le foto</a>
      </p>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="section home-cta" aria-labelledby="cta-title">
    <div class="container home-cta-inner">
      <h2 id="cta-title">Visita la palestra</h2>
      <p class="lede">
        Chiama per tutte le info e per avere un appuntamento per visitare la
        palestra. Valuteremo insieme le tue esigenze e le tue richieste per il
        tuo benessere.
      </p>
      <div class="home-cta-actions">
        {
          SITE.phones.map((phone) => (
            <a class="btn btn-primary" href={phone.href}>
              {phone.label}
            </a>
          ))
        }
        <a class="btn btn-ghost" href={path('/contatti')}>Contatti e come arrivare</a>
      </div>
    </div>
  </section>
</BaseLayout>
