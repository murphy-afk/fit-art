---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { NavSlug } from '../data/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  current?: NavSlug;
}

const { title, description, current } = Astro.props;

const defaultDescription =
  "Fit'Art — palestra e galleria d'arte a Rosate (MI). Allenamenti personalizzati, preparazione atletica, posturologia, chinesiologia, massoterapia.";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — Fit'Art StudioFitness Rosate</title>
    <meta name="description" content={description ?? defaultDescription} />
    <!-- Favicon temporaneo: logo IG. Favicon definitivo nella Session 6. -->
    <link rel="icon" type="image/jpeg" href="/images/logo-s150x150.jpg" />
  </head>
  <body>
    <Header current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
